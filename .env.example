# Copy to .env and fill in. Any provider without a key runs in mock mode,
# so the office works out of the box with no keys at all.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Override the default models used by the built-in roster.
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-5

# Force every agent into mock mode (no API calls, no cost).
MOCK_PROVIDERS=false

PORT=8787
